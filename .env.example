# Copy to .env (and load it however you prefer — e.g. `export $(cat .env | xargs)`,
# django-environ, or your process manager) before running against production
# settings. None of these have safe secrets checked into source control.

# Django core
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.example.com
DJANGO_LOG_LEVEL=INFO

# Database — omit DJANGO_DB_ENGINE entirely to use SQLite (local dev/tests).
# Set DJANGO_DB_ENGINE=postgresql to use PostgreSQL in production.
DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=fantacalcio
DJANGO_DB_USER=fantacalcio
DJANGO_DB_PASSWORD=change-me
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432
DJANGO_DB_CONN_MAX_AGE=60
